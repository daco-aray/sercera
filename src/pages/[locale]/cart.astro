---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocaleFromParams, LOCALES, getUrlWithLocale } from "@/i18n";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const isEnglish = locale === "en";
---

<BaseLayout title={isEnglish ? "Enquiries — Ser Cerámico" : "Consultas — Ser Cerámico"} description={isEnglish ? "Ask about availability and purchase via WhatsApp." : "Consulta disponibilidad y compra por WhatsApp."}>
  <main id="main-content" class="mx-auto max-w-screen-xl px-6 py-28 text-center">
    <p class="text-xs uppercase tracking-[0.25em] text-faded">Ser Cerámico</p>
    <h1 class="mt-5 font-serif text-5xl">{isEnglish ? "Purchase via WhatsApp" : "Compra por WhatsApp"}</h1>
    <p class="mx-auto mt-6 max-w-lg leading-relaxed text-faded">{isEnglish ? "Choose a piece from the catalogue to ask about availability and complete your purchase directly through WhatsApp." : "Selecciona una pieza del catálogo para consultar disponibilidad y concretar tu compra directamente por WhatsApp."}</p>
    <a href={getUrlWithLocale("/catalog", locale)} class="mt-10 inline-flex rounded-full bg-ink px-7 py-4 text-xs uppercase tracking-widest text-[var(--color-base)] transition-colors hover:bg-accent">{isEnglish ? "View catalogue" : "Ver catálogo"}</a>
  </main>
</BaseLayout>
