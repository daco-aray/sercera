---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/atelier-workshop.jpg";
import sercera3Img from "@/assets/sercera_3.png";
import sercera4Img from "@/assets/sercera_4.png";
import { getLocaleFromUrl, t } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout
  title={locale === "en" ? "About Ser Cerámico — Ser Cerámico" : "Sobre Ser Cerámico — Ser Cerámico"}
  description={locale === "en" ? "A small studio creating ceramic pieces with an intimate, organic, and contemporary vision inspired by Costa Rican biodiversity." : "Un pequeño taller que crea piezas cerámicas con una mirada íntima, orgánica y contemporánea inspirada en la biodiversidad de Costa Rica."}
  image={workshopImg}
>
  <main id="main-content">
  <section class="mx-auto max-w-screen-xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
    <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
      <span class="inline-block h-px w-8 bg-ink/40"></span>
      {t(locale, "aboutBadge")}
    </p>
    <h1 class="max-w-[20ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
      {t(locale, "aboutTitle")} <span class="italic text-accent">{t(locale, "aboutTitleAccent")}</span>
    </h1>
    <p class="mt-8 max-w-[60ch] text-lg leading-relaxed text-faded">
      {t(locale, "aboutDescription")}
    </p>
  </section>

  <section class="relative w-full px-6 md:px-8">
    <div class="mx-auto max-w-screen-xl">
      <div class="grid gap-4 md:grid-cols-[1.05fr_0.95fr] md:gap-6">
        <div class="overflow-hidden rounded-[1.75rem] border border-line bg-paper shadow-[0_24px_80px_rgba(0,0,0,0.08)]">
          <Image
            src={sercera3Img}
            alt="Sercera piece inspired by Costa Rican biodiversity"
            width={1600}
            height={1200}
            format="webp"
            loading="eager"
            class="h-[45vh] w-full object-cover md:h-[70vh]"
          />
        </div>
        <div class="overflow-hidden rounded-[1.75rem] border border-line bg-paper shadow-[0_24px_80px_rgba(0,0,0,0.08)] md:-translate-y-6">
          <Image
            src={sercera4Img}
            alt="Second Sercera piece presented alongside the first"
            width={1600}
            height={1200}
            format="webp"
            loading="eager"
            class="h-[45vh] w-full object-cover md:h-[70vh]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-24 grid max-w-screen-xl gap-10 px-6 md:mt-32 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5">
      <p class="mb-6 text-[11px] uppercase tracking-[0.3em] text-faded">{t(locale, "aboutInspiration")}</p>
      <h2 class="text-balance font-serif text-3xl leading-[1.02] md:text-5xl">{t(locale, "aboutInspirationTitle")}</h2>
    </div>
    <div class="space-y-6 leading-relaxed text-faded md:col-span-6 md:col-start-7">
      <p>
        En estas piezas, elementos del mundo costero como erizos, estrellas de mar y cactus son reinterpretados desde un lenguaje propio, íntimo y contemporáneo. La cerámica se vuelve un vehículo para narrar la biodiversidad de Costa Rica con forma, textura y presencia.
      </p>
      <p>
        La obra combina una sensibilidad orgánica con referencias ancestrales, convirtiendo cada figura en un ser que dialoga con la naturaleza y con la historia.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-screen-xl border-t border-line px-6 pt-12 md:mt-32">
    <p class="mb-12 text-[11px] uppercase tracking-[0.3em] text-faded">{t(locale, "aboutTechnique")}</p>
    <div class="grid gap-x-8 gap-y-12 md:grid-cols-3">
      {
        [
          {
            n: "01",
            h: "Cerámica de autor",
            p: "Cada pieza se desarrolla con una mirada íntima y experimental, cuidando la forma, el volumen y el carácter de cada superficie.",
          },
          {
            n: "02",
            h: "Esmalte de alta temperatura",
            p: "El jarrón fue esmaltado en alta temperatura (Cono 6), logrando un acabado resistente y vivo que resalta la pieza.",
          },
          {
            n: "03",
            h: "Raku y acabado singular",
            p: "Los platitos fueron esmaltados en Raku, una técnica japonesa que permite conseguir terminaciones tan particulares y únicas.",
          },
        ].map((block) => (
          <div class="space-y-3">
            <p class="text-[10px] uppercase tracking-[0.3em] text-faded tabular-nums">{block.n}</p>
            <h3 class="font-serif text-2xl">{block.h}</h3>
            <p class="text-sm leading-relaxed text-faded">{block.p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-24 md:mt-32">
    <div class="mx-auto grid max-w-screen-2xl items-center gap-10 px-6 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <div class="aspect-[3/4] overflow-hidden rounded-[min(1vw,12px)] bg-paper">
          <Image
            src={handsImg}
            alt="Close-up of a craftsman's hands planing a piece of pale oak"
            width={1080}
            height={1440}
            format="webp"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
      <div class="space-y-8 md:col-span-6 md:col-start-7">
        <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
          <span class="inline-block h-px w-8 bg-ink/40"></span>
          {t(locale, "aboutMaterialsLabel")}
        </p>
        <blockquote class="text-balance font-serif text-3xl leading-[1.15] md:text-4xl">
          "We don't buy lumber by the pallet. Every board is chosen
          <span class="italic text-accent">for the piece it will become</span> — sometimes months before it is cut."
        </blockquote>
        <p class="text-xs uppercase tracking-[0.25em] text-faded">— Erik Lindgren, founder</p>
        <div class="space-y-3 border-t border-line pt-6 text-sm leading-relaxed text-faded">
          <p>
            European oak from managed Swedish forests. Curved ash from a small reserve on the south coast. American walnut from a family mill in Pennsylvania. Three woods. No more.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-screen-xl border-y border-line px-6 py-12 md:mt-32">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
      {
        [
          { n: "2018", l: "Founded" },
          { n: "2", l: "Makers" },
          { n: "3", l: "Timbers" },
          { n: "4–10", l: "Weeks lead time" },
        ].map((stat) => (
          <div class="space-y-2">
            <p class="font-serif text-4xl tabular-nums md:text-5xl">{stat.n}</p>
            <p class="text-[10px] uppercase tracking-[0.3em] text-faded">{stat.l}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="studio" class="mx-auto mb-32 mt-12 max-w-screen-xl px-6 md:mt-16">
    <div class="grid items-end gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h2 class="max-w-[20ch] text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
          {t(locale, "aboutVisitTitle")}
        </h2>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row md:col-span-5 md:justify-end">
        <a
          href="/catalog"
          class="inline-flex items-center justify-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
        >
          Ver el catálogo →
        </a>
        <a
          href="mailto:workshop@atelier-ko.example"
          class="inline-flex items-center justify-center gap-3 rounded-full px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-ink ring-1 ring-line transition-colors hover:bg-paper"
        >
          Escríbenos
        </a>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>
