---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocaleFromParams, t } from "@/i18n";

const locale = getLocaleFromParams(Astro.params);
---

<BaseLayout title={locale === "en" ? "Page not found — Ser Cerámico" : "Página no encontrada — Ser Cerámico"} description={locale === "en" ? "The page you're looking for doesn't exist or has been moved." : "La página que buscas no existe o ha sido movida."} noindex={true} includeHeader={false} includeFooter={false}>
  <main id="main-content" class="flex min-h-screen items-center justify-center bg-base px-4">
    <div class="max-w-md text-center">
      <h1 class="font-serif text-7xl">404</h1>
      <h2 class="mt-4 font-serif text-2xl">{t(locale, "notFoundTitle")}</h2>
      <p class="mt-2 text-sm text-faded">{t(locale, "notFoundCopy")}</p>
      <div class="mt-6">
        <a
          href={`/${locale}/catalog`}
          class="inline-flex items-center justify-center rounded-full bg-ink px-5 py-3 text-xs uppercase tracking-widest text-[var(--color-base)] transition-colors hover:bg-accent"
        >
          {t(locale, "notFoundCta")}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
